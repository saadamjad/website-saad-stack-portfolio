<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	Header set X-Content-Type-Options "nosniff"
	Header set X-Frame-Options "DENY"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
	Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	# Real browser protections. Right-click / Inspect / View Source cannot be
	# blocked — the page is already on the visitor's machine. CSP limits what
	# scripts and frames can do if something unexpected is injected.
	Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self' https:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

	# Cache everything on CDN by default
	Header set Cache-Control "public, s-maxage=604800, max-age=0"

	# Cache in browser all assets — safe to cache long since Vite gives every
	# build a unique content-hashed filename (index-XXXXXXXX.js/.css).
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=604800"
	</If>

	# index.html (and anything the SPA fallback rewrite serves) must NEVER be
	# cached by the CDN/browser. It's the one file whose name never changes
	# between deploys, so a stale cached copy keeps referencing asset hashes
	# from a previous build that no longer exist on disk — the browser then
	# gets a 200 HTML response for a .js/.css request (this exact bug: "server
	# responded with a MIME type of text/html"). Every visit must fetch fresh.
	<If "%{REQUEST_URI} !~ m#^/assets/.*$#">
		Header set Cache-Control "no-cache, must-revalidate"
	</If>
</IfModule>
