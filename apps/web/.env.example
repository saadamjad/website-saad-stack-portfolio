# Copy to apps/web/.env (gitignored) and fill in — never commit .env

# URL of the portfolio-agent service's chat endpoint (see the Personal-AI-Agent
# repo's DEPLOYMENT.md). Without this set, the chat widget has nothing to talk to
# and falls back to its dead local default ('/hcgi/platform/chat').
#
# Local dev (portfolio-agent running on :8000):
# VITE_CHAT_API_BASE=http://localhost:8000/api/v1/chat
#
# Production:
# VITE_CHAT_API_BASE=https://<your-railway-url>/api/v1/chat
VITE_CHAT_API_BASE=
