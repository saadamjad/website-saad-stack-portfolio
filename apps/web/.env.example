# Copy to apps/web/.env (gitignored) and fill in — never commit .env

# URL of the Langchain-AI-Agent chat endpoint.
# Without this set, the chat widget falls back to a dead local default
# ('/hcgi/platform/chat').
#
# Local (Langchain-AI-Agent on :8000):
# VITE_CHAT_API_BASE=http://localhost:8000/api/v1/chat
#
# Production:
# VITE_CHAT_API_BASE=https://<your-railway-url>/api/v1/chat
VITE_CHAT_API_BASE=http://localhost:8000/api/v1/chat
