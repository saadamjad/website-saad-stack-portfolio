# Copy to .env and fill in values (never commit .env)
#   cp .env.example .env

# ── PocketBase (local dev) ───────────────────────────────────────────────────
# PB_ENCRYPTION_KEY must be exactly 32 characters
PB_ENCRYPTION_KEY=01234567890123456789012345678901
PB_SUPERUSER_EMAIL=admin@local.dev
PB_SUPERUSER_PASSWORD=change-me-local-dev-only

# ── ZizkaDB (server-side only — PocketBase hooks, NOT the Vite frontend) ─────
ZIZKADB_API_KEY=
ZIZKADB_HOST=https://db.zizka.ai
ZIZKADB_AGENT_ID=chat-agent-saad-portfolio

# ── LLM (required for smart agent — pick OpenAI OR Anthropic) ────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alternative to OpenAI (used if OPENAI_API_KEY is empty):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Smart agent options ─────────────────────────────────────────────────────
# Auto-save LLM Q&A pairs to ZizkaDB so similar questions improve over time
CHAT_AUTO_LEARN=true
CHAT_LEARN_MIN_CHARS=40

# ── Admin routes (seed, teach) ───────────────────────────────────────────────
CHAT_ADMIN_SECRET=local-dev-admin-secret
