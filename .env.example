# Copy to .env and fill in values (never commit .env)
#   cp .env.example .env

# ── PocketBase (local dev) ───────────────────────────────────────────────────
# PB_ENCRYPTION_KEY must be exactly 32 characters
PB_ENCRYPTION_KEY=01234567890123456789012345678901
PB_SUPERUSER_EMAIL=admin@local.dev
PB_SUPERUSER_PASSWORD=change-me-local-dev-only

# Contact form notifications (PocketBase hook). Defaults to contact@saadstack.com
# if unset. Delivery uses PocketBase SMTP, or BUILDER_MAILER_* when SMTP is off.
CONTACT_NOTIFY_EMAIL=contact@saadstack.com

# The AI chat agent no longer lives in this repo — it's a separate service
# (personal-assistant). To point the site's chat widget at it locally or in
# production, set VITE_CHAT_API_BASE in apps/web/.env (see that app's docs).
