# Copy to .env and fill in values (never commit .env)
#   cp .env.example .env

# ── PocketBase (local dev) ───────────────────────────────────────────────────
# PB_ENCRYPTION_KEY must be exactly 32 characters
PB_ENCRYPTION_KEY=01234567890123456789012345678901
PB_SUPERUSER_EMAIL=admin@local.dev
PB_SUPERUSER_PASSWORD=change-me-local-dev-only

# ── LLM (required for smart agent — pick OpenAI OR Anthropic) ────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alternative to OpenAI (used if OPENAI_API_KEY is empty):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: force a specific provider when both keys are set above.
# Leave empty to auto-detect (OpenAI preferred if both are present).
# Must be exactly "openai" or "anthropic" if set.
CHAT_LLM_PROVIDER=

# ── Chat safety/cost controls ────────────────────────────────────────────────
CHAT_MAX_LLM_CALLS_PER_DAY=300
